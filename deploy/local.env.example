# 复制成 deploy/local.env 再填（local.env 不进 git）。sync-and-deploy.sh 会读它，
# 并替换 deploy/k8s.yaml 里的占位符。
SSH_HOST=root@203.0.113.10                  # K3s 节点
LEDGER_HOST=ledger.example.com              # 网站域名
MAIL_INBOUND_ADDRESS=ledger@example.com     # 可选：收账单的地址（Cloudflare Email Routing）
MAIL_ALLOWED_SENDERS=me@example.com,@university.ac.uk   # 可选：只收这些发件人转发来的账单
RECIPES_URL=                                # 可选：菜谱站地址，食材页给「找菜谱」链接
